# MangaDex CORS proxy (web only) — api.mangadex.org blocks browser requests,
# so the web app routes API calls through a serverless proxy that adds CORS
# headers. Set this to the deployed proxy base URL (e.g. Vercel):
#   EXPO_PUBLIC_MANGADEX_PROXY_URL=https://<your-host>/api/mangadex
# Leave unset for native builds and local dev (direct api.mangadex.org calls).
# Deploy instructions: api/mangadex/README.md
EXPO_PUBLIC_MANGADEX_PROXY_URL=
