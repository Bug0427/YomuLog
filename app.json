{
  "expo": {
    "name": "YomuLog",
    "slug": "YomuLog",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": ["ios", "android", "web"],
    "icon": "./assets/logo.png",
    "owner": "bug0427",
    "jsEngine": "hermes",
    "runtimeVersion": "1.0.0",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#AFA6DD"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/YOMULOG_PROJECT_ID"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yomulog.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "YomuLog uses your photo library for reverse image search to find manga by cover art.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#AFA6DD"
      },
      "package": "com.yomulog.app",
      "permissions": ["INTERNET", "READ_EXTERNAL_STORAGE", "WRITE_EXTERNAL_STORAGE"]
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "YOMULOG_PROJECT_ID"
      }
    }
  }
}
